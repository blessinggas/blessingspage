# Copy this file to `.env` (same folder) and fill in your own values.
# .env is git-ignored — your keys never leave your Mac.

# ── Trading 212 (generate in the T212 mobile app → Settings → API) ──
T212_API_KEY=
T212_ENV=demo          # 'demo' while testing, 'live' for real data

# ── GoCardless Bank Account Data (free: bankaccountdata.gocardless.com) ──
GC_SECRET_ID=
GC_SECRET_KEY=
GC_COUNTRY=GB
GC_INSTITUTION=        # e.g. MONZO_MONZGB2L — run: node gocardless.mjs institutions
